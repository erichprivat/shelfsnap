# Required
BETTER_AUTH_SECRET=        # openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3000

# Optional — without these the app still runs locally
ANTHROPIC_API_KEY=         # shelf snap reads real photos; without it a demo shelf is returned
SPINE_READER_MODEL=claude-opus-5-5   # or claude-sonnet-5-5 (half the cost) / claude-haiku-5-5
SNAP_MONTHLY_LIMIT=10      # free shelf snaps per user per month, or "unlimited"
SNAP_DAILY_BUDGET_USD=3    # model spend across all readers per UTC day before snaps pause, or "unlimited"
RESEND_API_KEY=            # sends sign-in emails; in development the link is shown on screen instead
EMAIL_FROM="Readmoth <hello@example.com>"
FEEDBACK_TO=               # where in-app feedback is forwarded (it is always stored; see /admin)
ADMIN_EMAILS=              # comma-separated; these readers can open /admin
SIGNUPS=                   # "invite" to allow new accounts only for INVITED_EMAILS and ADMIN_EMAILS
INVITED_EMAILS=            # comma-separated; who may create an account when SIGNUPS=invite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
DATABASE_URL=file:./data/readmoth.db
UPLOAD_DIR=data/uploads
SPINE_READER_FIXTURE=      # development: replay a recorded spine reading, e.g. fixtures/img-2859.json
