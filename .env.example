# Required
BETTER_AUTH_SECRET=        # openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3000

# Optional — without these the app still runs locally
ANTHROPIC_API_KEY=         # shelf snap reads real photos; without it a demo shelf is returned
RESEND_API_KEY=            # sends sign-in emails; in development the link is shown on screen instead
EMAIL_FROM="Shelfsnap <hello@example.com>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
DATABASE_URL=file:./data/shelfsnap.db
UPLOAD_DIR=data/uploads
SPINE_READER_FIXTURE=      # development: replay a recorded spine reading, e.g. fixtures/img-2859.json
